{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist-voice",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["server/voice/**/*.ts", "src/voice/protocol.ts"]
}
