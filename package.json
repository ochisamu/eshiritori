{
  "name": "eshiritori-rensen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "tsx tools/build-content.ts",
    "prebuild": "npm run content",
    "pretest": "npm run content",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "serve": "node tools/serve.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=reports/unit-results.json && node tools/check-core-coverage.mjs",
    "test:e2e": "playwright test",
    "audit": "tsx tools/audit.ts",
    "check-acceptance": "node tools/check-acceptance.mjs",
    "voice:build": "tsc -p tsconfig.voice.json",
    "voice": "node dist-voice/server/voice/index.js",
    "voice:dev": "tsx server/voice/index.ts",
    "voice:smoke": "tsx tools/live-smoke.ts"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "openai": "7.46.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
