# Optional voice mode only. Leave the key empty in every distributed copy.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-6-luna
OPENAI_DECISIONS_MODEL=gpt-6-luna
OPENAI_LIVE_VOICE=marin

VOICE_PORT=4174
VOICE_LAN=false
# LAN requires trusted HTTPS, exact origins, and a certificate with matching SANs.
VOICE_TLS_CERT=
VOICE_TLS_KEY=
VOICE_ALLOWED_ORIGINS=http://localhost:4174,http://127.0.0.1:4174
VOICE_MAX_SESSION_SECONDS=900
VOICE_IDLE_CLOSE_SECONDS=60
VOICE_DECISIONS_ENABLED=true
VOICE_MAX_BACKEND_CALLS_PER_MINUTE=12
VOICE_MAX_BACKEND_CALLS_PER_SESSION=120
VOICE_MAX_DECISIONS_CALLS_PER_SESSION=300
# Estimated per-process budget; this is not an OpenAI billing limit.
VOICE_BUDGET_USD=1
VOICE_PRICE_DATE=2026-10-31
VOICE_PRICE_LIVE_MINUTE=0.05
# Set these to match both selected backend models. No tool charges are used.
VOICE_PRICE_INPUT_MILLION=0.10
VOICE_PRICE_OUTPUT_MILLION=0.50
# Explicit real-API test authorization is set in the test command, never by default.
